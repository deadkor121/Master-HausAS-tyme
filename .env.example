# Пример переменных окружения для проекта

# Для apps/api
# Строка подключения к базе (Postgres, MySQL и т.п.)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Секрет для подписи JWT
JWT_SECRET=your_jwt_secret_here
# Производственный режим
NODE_ENV=production

# Для Prisma (если нужно отдельно)
# PRISMA_GENERATE=true

# Для apps/web (Vite: переменные должны начинаться с VITE_)
# Адрес API (после деплоя укажите URL вашего API)
VITE_API_URL=https://your-api-url.vercel.app/api
